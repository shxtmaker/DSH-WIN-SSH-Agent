#!/bin/sh
# Install at the controller's fixed helperPath on the remote Linux host.
set -eu
export DSH_HOME='/home/harness/.dsh'
export DSH_REMOTE_INSTANCE_KEYS='default'
# Git installation in the web profile. Replace the absolute user/profile paths.
# For the standalone tgz, use node_modules/@harness-remote/companion/bin/dsh-remote-info.mjs instead.
exec /usr/bin/env node '/home/harness/.dsh/profiles/web/node_modules/dsh-win-ssh-agent-source/runtime/bin/dsh-remote-info.mjs' "$@"

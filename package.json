{
  "name": "dsh-win-ssh-agent-source",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness Linux companion and restricted SSH discovery helper",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare:upstream": "node scripts/prepare-upstream.mjs",
    "build": "node scripts/build.mjs",
    "pack": "node scripts/build.mjs --pack-only",
    "test": "node --test tests/project.test.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "verify:project": "node scripts/verify-project.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs"
  },
  "packageManager": "pnpm@11.7.0",
  "main": "runtime/index.js",
  "types": "runtime/types/index.d.ts",
  "bin": {
    "dsh-remote-info": "runtime/bin/dsh-remote-info.mjs"
  },
  "exports": {
    ".": {
      "types": "./runtime/types/index.d.ts",
      "default": "./runtime/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "runtime",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
